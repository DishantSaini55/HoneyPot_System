# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://honeypot:change-me@postgres:5432/honeypot
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
SENSOR_API_KEY=replace-with-at-least-24-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-before-running-bootstrap
CORS_ORIGINS=http://localhost:3000
MAX_EVENT_BODY_BYTES=262144
SSH_PORT=2222
HTTP_HONEYPOT_PORT=8080
INGESTION_URL=http://api:8000/api/v1/ingest/events
THREAT_INTEL_PROVIDER_URL=
THREAT_INTEL_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=3
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=
ML_MODEL_PATH=/app/ml/model/baseline.joblib
LOG_LEVEL=INFO

